{
  "name": "resilient-http",
  "version": "2.1.0",
  "description": "Zero-dependency, fetch-first HTTP resilience toolkit: retries with backoff/jitter, per-attempt timeout + total deadline, idempotency-key, interceptor hooks, and standardized errors. Node.js, Bun, browsers.",
  "packageManager": "pnpm@11.1.3",
  "author": "valianx",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valianx/resilient-http.git"
  },
  "bugs": {
    "url": "https://github.com/valianx/resilient-http/issues"
  },
  "homepage": "https://github.com/valianx/resilient-http#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun test",
    "test:node": "node --import tsx --test tests/*.test.ts",
    "test:mutation": "stryker run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@stryker-mutator/core": "^9.6.1",
    "@types/node": "^22",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "bun-types": "^1.0.0",
    "eslint": "^10.4.0",
    "prettier": "^3.8.3",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "http",
    "retry",
    "resilience",
    "error-handling",
    "backoff",
    "jitter",
    "exponential-backoff",
    "fetch",
    "idempotency-key",
    "timeout",
    "abortsignal",
    "bun",
    "nodejs",
    "typescript",
    "fault-tolerance"
  ],
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9"
  }
}
