{
  "name": "resilient-http",
  "version": "2.0.0",
  "description": "Framework-agnostic HTTP resilience library with retry logic and error extraction. Works with Node.js, Bun, and browsers.",
  "packageManager": "pnpm@11.1.3",
  "author": "valianx",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/valianx/resilient-http.git"
  },
  "bugs": {
    "url": "https://github.com/valianx/resilient-http/issues"
  },
  "homepage": "https://github.com/valianx/resilient-http#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun test",
    "test:node": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "bun-types": "^1.0.0",
    "eslint": "^10.4.0",
    "prettier": "^3.8.3",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "http",
    "retry",
    "resilience",
    "error-handling",
    "backoff",
    "jitter",
    "exponential-backoff",
    "fetch",
    "axios",
    "got",
    "bun",
    "nodejs",
    "typescript",
    "fault-tolerance"
  ],
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9"
  }
}
